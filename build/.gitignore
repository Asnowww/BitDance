# ================================
# BitDance .gitignore
# ================================

# ---- Claude Code 本地协作配置（不入库） ----
.claude/

# ---- 环境变量与敏感配置 ----
.env
.env.*
*.local
!*.example
# 前端默认环境变量（不含密钥）允许入库
!frontend/.env.development
!frontend/.env.production
docs/.db-credentials.local.md
application-local.yml
application-local.yaml
application-local.properties

# ---- Node / 前端 ----
node_modules/
dist/
dist-ssr/
.vite/
.cache/
coverage/
.eslintcache
.stylelintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Java / Spring Boot ----
target/
build/
out/
*.class
*.jar
*.war
*.ear
*.iml
.gradle/
.mvn/
hs_err_pid*
replay_pid*

# ---- IDE ----
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- 日志与临时 ----
*.log
logs/
tmp/
temp/
*.tmp
*.bak

# ---- LaTeX 中间产物（开题书目录有） ----
*.aux
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
