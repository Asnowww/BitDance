# Copy to application-local.yml (gitignored) and fill in real credentials.
spring:
  datasource:
    url: jdbc:postgresql://98.142.241.155:5432/bitdance?currentSchema=bitdance
    username: BitDance
    password: REPLACE_ME
  data:
    redis:
      host: localhost
      port: 6379

bitdance:
  jwt:
    secret: REPLACE_WITH_32_BYTE_RANDOM_STRING
  sms:
    mock: true
  maps:
    tencent:
      # M1 腾讯地图服务端 Key：填腾讯位置服务 WebService Key，真实值只放本地 gitignored 配置。
      key: REPLACE_WITH_TENCENT_MAP_WEBSERVICE_KEY
      referer: BitDance
