# Copy this file to build/.env.local and fill local-only secrets.
# build/.env.local is ignored by git.
NGROK_DOMAIN=tapioca-roman-dole.ngrok-free.dev
NGROK_AUTHTOKEN=

# Required for real WeChat OAuth login.
BITDANCE_WECHAT_APP_ID=
BITDANCE_WECHAT_APP_SECRET=
BITDANCE_WECHAT_SCOPE=snsapi_userinfo

# Optional: real Aliyun phone verification.
BITDANCE_SMS_MOCK=true
BITDANCE_SMS_PROVIDER=aliyun-pnvs
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
